{
  "data_type": "transactions",
  "name": "Transaction Data",
  "description": "Financial transaction data including cash deposits, withdrawals, and transfers",
  "status": "ACTIVE",
  "schema_definition": {
    "fields": {
      "customer_id": {
        "type": "string",
        "description": "Unique customer identifier"
      },
      "date": {
        "type": "string",
        "format": "datetime",
        "description": "Transaction date and time"
      },
      "debit": {
        "type": "number",
        "description": "Debit amount"
      },
      "credit": {
        "type": "number",
        "description": "Credit amount"
      },
      "closingBalance": {
        "type": "number",
        "description": "Balance after transaction"
      },
      "narrative": {
        "type": "string",
        "description": "Transaction description"
      },
      "source": {
        "type": "string",
        "description": "Transaction source"
      },
      "is_anomaly": {
        "type": "number",
        "description": "Anomaly indicator (0 or 1)"
      }
    },
    "required": ["customer_id", "date"]
  },
  "sample_data": {
    "transactions": [
      {
        "closingBalance": 5000,
        "credit": 1000,
        "customer_id": "CUST_12345",
        "date": "2024-10-25T14:30:00",
        "debit": 0,
        "is_anomaly": 0,
        "narrative": "Cash Deposit BY SELF",
        "source": "CASH DEPOSIT"
      }
    ]
  }
}

