# Application Settings
PROJECT_NAME="KYC & Transaction Anomaly Detection API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
DEBUG=false
LOG_LEVEL="INFO"

# CORS Settings
ALLOWED_ORIGINS="*"

# Security
API_KEY_ENABLED=false
API_KEY="your-secret-api-key-change-in-production"

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Model Paths
KYC_MODEL_PATH="data/models/kyc_model.pkl"
TRANSACTION_MODEL_PATH="data/models/transaction_model.pkl"
KYC_SCALER_PATH="data/models/kyc_scaler.pkl"
TRANSACTION_SCALER_PATH="data/models/transaction_scaler.pkl"

# Model Parameters
CONTAMINATION=0.1
N_ESTIMATORS=100
RANDOM_STATE=42

# Anomaly Thresholds
HIGH_RISK_THRESHOLD=-0.3
MEDIUM_RISK_THRESHOLD=-0.1

# Database (Optional)
DATABASE_URL="sqlite:///./anomaly_detection.db"
# DATABASE_URL="postgresql://user:password@localhost/dbname"

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090